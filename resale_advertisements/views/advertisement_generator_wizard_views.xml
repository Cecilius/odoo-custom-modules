<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="resale_advertisement_generator_form" model="ir.ui.view">
        <field name="name">resale.advertisement.generator.form</field>
        <field name="model">resale.advertisement.generator</field>
        <field name="arch" type="xml">
            <form string="Generate Description">
                <group>
                    <field name="product_template_id" readonly="1"/>
                    <field name="max_characters"/>
                </group>

                <!-- Information Sent to AI -->
                <separator string="Information sent to AI"/>
                <field name="research_info" readonly="1" widget="text" nolabel="1" class="w-100 mb-3"/>

                <!-- Status -->
                <div invisible="state != 'error'" class="mb-3">
                    <separator string="Status"/>
                    <field name="error_message" readonly="1" widget="text" nolabel="1" class="text-danger w-100"/>
                </div>

                <!-- Confirmation Required -->
                <div invisible="state != 'confirm_overwrite'" class="mb-3">
                    <separator string="Confirmation required"/>
                    <field name="error_message" readonly="1" widget="text" nolabel="1" class="text-warning w-100 mb-2"/>
                    <button name="action_confirm_generate" type="object" string="Overwrite and Generate" class="btn-primary"/>
                </div>

                <!-- AI Proposals (Full Width Stack) -->
                <div invisible="state != 'proposals'" class="w-100">
                    <separator string="AI Proposals"/>

                    <!-- Proposal 1 -->
                    <separator string="Proposal 1"/>
                    <field name="proposal_1" widget="text" nolabel="1" class="w-100 mb-2"/>
                    <div class="mb-4">
                        <button name="action_use_proposal_1" type="object" string="Use Proposal 1" class="btn-primary"/>
                    </div>

                    <!-- Proposal 2 -->
                    <separator string="Proposal 2"/>
                    <field name="proposal_2" widget="text" nolabel="1" class="w-100 mb-2"/>
                    <div class="mb-4">
                        <button name="action_use_proposal_2" type="object" string="Use Proposal 2" class="btn-primary"/>
                    </div>

                    <!-- Proposal 3 -->
                    <separator string="Proposal 3"/>
                    <field name="proposal_3" widget="text" nolabel="1" class="w-100 mb-2"/>
                    <div class="mb-4">
                        <button name="action_use_proposal_3" type="object" string="Use Proposal 3" class="btn-primary"/>
                    </div>
                </div>

                <footer>
                    <button name="action_generate" type="object" string="Generate 3 Proposals" class="btn-primary" invisible="state in ('error', 'confirm_overwrite')"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
