<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend Product Category Form View to add category_code -->
    <record id="product_category_form_view_inherit_rfb" model="ir.ui.view">
        <field name="name">product.category.form.inherit.rfb</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='parent_id']" position="after">
                <field name="category_code" placeholder="e.g. 01"/>
            </xpath>
        </field>
    </record>

    <!-- Extend Product Category List View to show category_code column -->
    <record id="product_category_list_view_inherit_rfb" model="ir.ui.view">
        <field name="name">product.category.list.inherit.rfb</field>
        <field name="model">product.category</field>
        <field name="inherit_id" ref="product.product_category_list_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='complete_name']" position="after">
                <field name="category_code" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
