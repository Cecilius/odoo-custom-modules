<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.resale.ai.manufacturer</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="resale_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='resale']/block[@name='resale_settings_block']" position="after">
                <block title="AI Manufacturer" name="resale_ai_manufacturer_setting_container">
                    <setting string="GPSR research agent">
                        <field name="resale_ai_manufacturer_research_agent_id"/>
                    </setting>
                    <setting string="Backup GPSR research agent">
                        <field name="resale_ai_manufacturer_backup_agent_id"/>
                    </setting>
                    <setting string="AI request timeout">
                        <field name="resale_ai_manufacturer_request_timeout"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
