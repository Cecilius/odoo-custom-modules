#. module: simplified_invoice
#: model:ir.model.fields,help:simplified_invoice.field_base_document_layout__company_registry
msgid ""
"The registry number of the company. Use it if it is different from the Tax "
"ID. It must be unique across all partners of a same country"
msgstr ""
"El número de registro de la empresa. Úselo si es distinto del NIF. Debe ser "
"único entre todos los contactos de un mismo país"

#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/account_move.py:0
msgid ""
"This invoice is classified as full by the Spanish localization, but it is "
"not using the configured full sales journal."
msgstr ""
"La localización española clasifica esta factura como completa, pero no usa "
"el diario de ventas completas configurado."

#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/account_move.py:0
msgid ""
"This invoice is classified as simplified by the Spanish localization, but it"
" is not using the configured simplified sales journal."
msgstr ""
"La localización española clasifica esta factura como simplificada, pero no "
"usa el diario de ventas simplificadas configurado."

#. module: simplified_invoice
#: model:ir.model.fields,help:simplified_invoice.field_res_company__full_sales_journal_id
#: model:ir.model.fields,help:simplified_invoice.field_res_config_settings__full_sales_journal_id
msgid "Used as the default sales journal for non-simplified invoices."
msgstr ""
"Se usa como diario de ventas por defecto para las facturas no simplificadas."

#. module: simplified_invoice
#: model:ir.model.fields,help:simplified_invoice.field_res_company__simplified_sales_journal_id
#: model:ir.model.fields,help:simplified_invoice.field_res_config_settings__simplified_sales_journal_id
msgid ""
"Used when a Spanish invoice is detected as simplified by "
"l10n_es_is_simplified."
msgstr ""
"Se usa cuando la localización española detecta una factura como simplificada"
" mediante l10n_es_is_simplified."

#. module: simplified_invoice
#: model_terms:ir.ui.view,arch_db:simplified_invoice.res_config_settings_view_form_simplified_invoice_workflow
msgid ""
"Uses company.l10n_es_simplified_invoice_limit from the Spanish localization "
"instead of a hard-coded limit."
msgstr ""
"Usa company.l10n_es_simplified_invoice_limit de la localización española en "
"lugar de un límite fijo."

#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/invoice_wizard.py:0
msgid ""
"You can only change the journal and simplified flag while the invoice is "
"still in draft."
msgstr ""
"Solo puede cambiar el diario y la marca de simplificada mientras la factura "
"esté en borrador."
