#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/account_move.py:0
msgid ""
"%(invoice)s exceeds the Spanish simplified invoice limit, but it is marked "
"as simplified."
msgstr ""
"%(invoice)s supera el límite de factura simplificada español, pero está "
"marcada como simplificada."

#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/account_move.py:0
msgid ""
"%(invoice)s: full invoices for Spanish customers require a VAT/NIF before "
"posting."
msgstr ""
"%(invoice)s: las facturas completas para clientes españoles requieren un NIF"
" antes de publicarse."

#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/account_move.py:0
msgid ""
"%(invoice)s: you cannot create simplified invoices for company-type (B2B) "
"customers."
msgstr ""
"%(invoice)s: no se pueden emitir facturas simplificadas a clientes de tipo "
"empresa (B2B)."

#. module: simplified_invoice
#. odoo-python
#: code:addons/simplified_invoice/models/account_move.py:0
msgid ""
"%(invoice)s: you cannot create simplified invoices for customers outside "
"Spain."
msgstr ""
"%(invoice)s: no se pueden emitir facturas simplificadas a clientes fuera de "
"España."

