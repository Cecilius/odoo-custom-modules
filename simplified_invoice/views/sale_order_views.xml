<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_simplified_invoice" model="ir.ui.view">
        <field name="name">sale.order.form.simplified.invoice</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_term_id']" position="after">
                <field name="invoice_mode"/>
                <field name="requires_full_invoice" readonly="1"/>
                <field name="invoice_review_state" readonly="1"/>
                <field name="tax_id_missing_warning" invisible="1"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_mark_invoice_review_approved" type="object" string="Approve Invoice Review" class="btn-primary" invisible="invoice_review_state == 'approved'"/>
                <button name="action_mark_invoice_review_pending" type="object" string="Set Review Pending" invisible="invoice_review_state == 'pending'"/>
            </xpath>
        </field>
    </record>
</odoo>
