<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_simplified_invoice_workflow" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.simplified.invoice.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='account']/block[last()]" position="after">
                <block title="Simplified Invoice Workflow" name="simplified_invoice_workflow" invisible="country_code != 'ES'">
                    <setting string="Simplified Sales Journal">
                        <field name="simplified_sales_journal_id"/>
                    </setting>
                    <setting string="Full Sales Journal">
                        <field name="full_sales_journal_id"/>
                    </setting>
                    <setting string="Localization limit source">
                        <div class="text-muted">
                            Uses company.l10n_es_simplified_invoice_limit from the Spanish localization instead of a hard-coded limit.
                        </div>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
