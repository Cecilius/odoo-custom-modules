<odoo>
    <record id="res_config_settings_view_form_simplified_invoice" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.simplified.invoice.workflow</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('settings')]" position="inside">
                <div class="app_settings_block" data-string="Simplified Invoice" string="Simplified Invoice">
                    <h2>Simplified Invoice</h2>
                    <div class="row mt16 o_settings_container">
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="simplified_sales_journal_id"/>
                                <field name="simplified_sales_journal_id"/>
                                <div class="text-muted">Journal used for invoices classified as simplified.</div>
                            </div>
                        </div>
                        <div class="col-12 col-lg-6 o_setting_box">
                            <div class="o_setting_right_pane">
                                <label for="full_sales_journal_id"/>
                                <field name="full_sales_journal_id"/>
                                <div class="text-muted">Default journal used for full invoices.</div>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
