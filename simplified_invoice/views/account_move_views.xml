<odoo>
    <record id="view_move_form_simplified_invoice" model="ir.ui.view">
        <field name="name">account.move.form.simplified.invoice.workflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='journal_div']" position="after">
                <field name="l10n_es_is_simplified" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
