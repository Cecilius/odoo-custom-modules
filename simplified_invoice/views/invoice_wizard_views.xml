<odoo>
    <record id="view_simplified_invoice_post_wizard_form" model="ir.ui.view">
        <field name="name">simplified.invoice.post.wizard.form</field>
        <field name="model">simplified.invoice.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Invoice journal and type mismatch">
                <group>
                    <field name="message" readonly="1" nolabel="1"/>
                    <field name="move_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_set_simplified" type="object" string="Simplified" class="btn-primary"/>
                    <button name="action_set_full" type="object" string="Full" class="btn-secondary"/>
                    <button name="action_cancel" type="object" string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>