<odoo>
    <record id="view_simplified_invoice_post_wizard_form" model="ir.ui.view">
        <field name="name">simplified.invoice.post.wizard.form</field>
        <field name="model">simplified.invoice.post.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Invoice Posting">
                <group>
                    <field name="message" nolabel="1" readonly="1"/>
                    <field name="move_id" invisible="1"/>
                </group>
                <footer>
                    <button name="action_confirm_post" type="object" string="Confirm" class="btn-primary"/>
                    <button name="action_cancel" type="object" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
