<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_product_tests" model="ir.ui.view">
        <field name="name">product.template.form.resale.product.tests</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Product Tests" name="resale_product_tests">
                    <xpath expr="//page[@name='resale_product_tests']/field[@name='resale_product_test_ids']" position="before">
                        <group string="Condition / Box" col="2">
                            <group>
                                <field name="condition_value_id"
                                    widget="selection"
                                    domain="[('attribute_id', '=', condition_attribute_id)]"
                                    options="{'no_create': True}"/>
                                <field name="condition_operator_text" readonly="1"/>
                            </group>
                            <group>
                                <field name="box_value_id"
                                    widget="selection"
                                    domain="[('attribute_id', '=', box_attribute_id)]"
                                    options="{'no_create': True}"/>
                            </group>
                        </group>
                    </xpath>
                    <field name="resale_product_test_ids" context="{'default_product_template_id': id}">
                        <list string="Product Tests" editable="bottom">
                            <field name="test_date" readonly="1"/>
                            <field name="tested_by_id"/>
                            <field name="result_id"/>
                            <field name="notes"/>
                        </list>
                        <form string="Product Test">
                            <sheet>
                                <group>
                                    <field name="product_template_id"/>
                                    <field name="test_date" readonly="1"/>
                                    <field name="tested_by_id"/>
                                    <field name="result_id"/>
                                </group>
                                <field name="notes"/>
                            </sheet>
                        </form>
                    </field>
                </page>
            </xpath>
            <field name="categ_id" position="after">
                <field name="resale_last_test_result_id" readonly="1" options="{'no_open': True}"/>
            </field>
        </field>
    </record>
</odoo>
