<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="resale_product_test_result_view_list" model="ir.ui.view">
        <field name="name">resale.product.test.result.list</field>
        <field name="model">resale.product.test.result</field>
        <field name="arch" type="xml">
            <list string="Test Results">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="resale_product_test_result_view_form" model="ir.ui.view">
        <field name="name">resale.product.test.result.form</field>
        <field name="model">resale.product.test.result</field>
        <field name="arch" type="xml">
            <form string="Test Result">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_product_test_result" model="ir.actions.act_window">
        <field name="name">Test Results</field>
        <field name="res_model">resale.product.test.result</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
