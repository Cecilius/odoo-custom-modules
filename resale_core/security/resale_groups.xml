<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_resale" model="ir.module.category">
        <field name="name">Resale</field>
        <field name="sequence">50</field>
    </record>

    <record id="resale_privilege" model="res.groups.privilege">
        <field name="name">Resale</field>
        <field name="category_id" ref="module_category_resale"/>
        <field name="sequence">50</field>
    </record>

    <record id="group_resale_user" model="res.groups">
        <field name="name">Resale User</field>
        <field name="privilege_id" ref="resale_privilege"/>
    </record>

    <record id="group_resale_manager" model="res.groups">
        <field name="name">Resale Manager</field>
        <field name="privilege_id" ref="resale_privilege"/>
        <field name="implied_ids" eval="[(4, ref('group_resale_user'))]"/>
    </record>

    <record id="base.user_admin" model="res.users">
        <field name="group_ids" eval="[(4, ref('group_resale_manager'))]"/>
    </record>
</odoo>
