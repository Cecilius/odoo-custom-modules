<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_rfb_label_tree" model="ir.ui.view">
        <field name="name">resale.rfb.label.tree</field>
        <field name="model">resale.rfb.label</field>
        <field name="arch" type="xml">
            <list>
                <field name="rfb"/>
                <field name="category_id"/>
                <field name="state"/>
                <field name="item_id"/>
                <field name="print_count"/>
            </list>
        </field>
    </record>

    <record id="view_resale_rfb_label_form" model="ir.ui.view">
        <field name="name">resale.rfb.label.form</field>
        <field name="model">resale.rfb.label</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="category_id"/>
                        <field name="sequence"/>
                        <field name="rfb"/>
                        <field name="state"/>
                        <field name="item_id"/>
                        <field name="print_batch"/>
                        <field name="print_count"/>
                        <field name="last_print_date"/>
                        <field name="reprint_reason"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_rfb_label" model="ir.actions.act_window">
        <field name="name">RFB Labels</field>
        <field name="res_model">resale.rfb.label</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
