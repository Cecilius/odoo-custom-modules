<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_item_tree" model="ir.ui.view">
        <field name="name">resale.item.tree</field>
        <field name="model">resale.item</field>
        <field name="arch" type="xml">
            <list>
                <field name="rfb"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="brand_id"/>
                <field name="condition_id"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_resale_item_form" model="ir.ui.view">
        <field name="name">resale.item.form</field>
        <field name="model">resale.item</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="intake,identifying,initial_eval,detailed_test,needs_repair,needs_dismantling,photo,pricing,publish,published,reserved,sold,delivered,returned,warranty,dismantled,scrapped,archived"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="rfb"/></h1>
                        <h2><field name="name" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Identification">
                            <field name="category_id"/>
                            <field name="brand_id"/>
                            <field name="model_es"/>
                            <field name="model_en"/>
                            <field name="label_id"/>
                            <field name="barcode"/>
                            <field name="product_id"/>
                            <field name="lot_id"/>
                            <field name="location_id"/>
                        </group>
                        <group string="Batch &amp; Sourcing">
                            <field name="batch_id"/>
                            <field name="source_item_id"/>
                            <field name="legacy_reference"/>
                            <field name="migration_status"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Codes &amp; Links">
                            <group>
                                <field name="asin"/>
                                <field name="ean"/>
                                <field name="upc"/>
                                <field name="manufacturer_serial"/>
                                <field name="amazon_es_url" widget="url"/>
                                <field name="amazon_uk_url" widget="url"/>
                                <field name="camel_url" widget="url"/>
                            </group>
                        </page>
                        <page string="Condition &amp; Testing">
                            <group>
                                <field name="condition_id"/>
                                <field name="functional_status"/>
                                <field name="completeness"/>
                            </group>
                        </page>
                        <page string="Pricing &amp; Cost">
                            <group>
                                <field name="initial_value"/>
                                <field name="condition_factor"/>
                                <field name="functional_factor"/>
                                <field name="completeness_factor"/>
                                <field name="adjusted_value"/>
                                <field name="acquisition_cost"/>
                                <field name="cost_status"/>
                                <field name="repair_cost"/>
                                <field name="parts_cost"/>
                                <field name="min_price"/>
                                <field name="recommended_price"/>
                                <field name="approved_price"/>
                            </group>
                        </page>
                        <page string="Warranty">
                            <group>
                                <field name="warranty_policy_id"/>
                                <field name="warranty_start"/>
                                <field name="warranty_end"/>
                            </group>
                        </page>
                        <page string="Sale">
                            <group>
                                <field name="sold_delivery_id"/>
                                <field name="sold_date"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_resale_item" model="ir.actions.act_window">
        <field name="name">Items</field>
        <field name="res_model">resale.item</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
