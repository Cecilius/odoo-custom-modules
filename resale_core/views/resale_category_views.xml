<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_category_tree" model="ir.ui.view">
        <field name="name">resale.category.tree</field>
        <field name="model">resale.category</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="code"/>
                <field name="name"/>
                <field name="is_other" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_resale_category_form" model="ir.ui.view">
        <field name="name">resale.category.form</field>
        <field name="model">resale.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="name"/>
                        <field name="is_other"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_category" model="ir.actions.act_window">
        <field name="name">Categories</field>
        <field name="res_model">resale.category</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
