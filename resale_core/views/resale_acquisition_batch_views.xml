<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_acquisition_batch_tree" model="ir.ui.view">
        <field name="name">resale.acquisition.batch.tree</field>
        <field name="model">resale.acquisition.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source_ref"/>
                <field name="acquisition_date"/>
                <field name="expected_items"/>
                <field name="received_items"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_resale_acquisition_batch_form" model="ir.ui.view">
        <field name="name">resale.acquisition.batch.form</field>
        <field name="model">resale.acquisition.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <field name="state" widget="statusbar" statusbar_visible="ordered,awaiting,received,allocating,locked,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="purchase_order_id"/>
                            <field name="source_ref"/>
                        </group>
                        <group>
                            <field name="acquisition_date"/>
                            <field name="expected_arrival"/>
                            <field name="received_date"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="tax_regime"/>
                        </group>
                    </group>
                    <group>
                        <field name="expected_items"/>
                        <field name="received_items"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" groups="base.group_user"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_resale_acquisition_batch" model="ir.actions.act_window">
        <field name="name">Acquisition Batches</field>
        <field name="res_model">resale.acquisition.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
