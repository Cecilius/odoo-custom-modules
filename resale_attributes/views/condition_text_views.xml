<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_condition_text_list" model="ir.ui.view">
        <field name="name">resale.condition.text.list</field>
        <field name="model">resale.condition.text</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="condition_attribute_id" column_invisible="True"/>
                <field name="condition_value_id"
                       domain="[('attribute_id', '=', condition_attribute_id)]"/>
                <field name="operator_text" optional="show"/>
                <field name="listing_text" optional="show"/>
                <field name="followup_text" optional="show"/>
                <field name="active" optional="show"/>
            </list>
        </field>
    </record>

    <record id="view_resale_condition_text_form" model="ir.ui.view">
        <field name="name">resale.condition.text.form</field>
        <field name="model">resale.condition.text</field>
        <field name="arch" type="xml">
            <form string="Condition Text">
                <sheet>
                    <group>
                        <field name="condition_attribute_id" invisible="1"/>
                        <field name="condition_value_id"
                               domain="[('attribute_id', '=', condition_attribute_id)]"/>
                        <field name="active"/>
                    </group>
                    <group>
                        <field name="operator_text" placeholder="Internal guidance for operators..."/>
                        <field name="listing_text" placeholder="Reusable customer-facing text..."/>
                        <field name="followup_text" placeholder="Invoice guidance..."/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_condition_text" model="ir.actions.act_window">
        <field name="name">Condition Texts</field>
        <field name="res_model">resale.condition.text</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
