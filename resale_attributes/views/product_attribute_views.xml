<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="attribute_tree_view_resale_lines" model="ir.ui.view">
        <field name="name">product.attribute.list.resale.lines</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.attribute_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_variant']" position="after">
                <field name="resale_show_on_lines"/>
            </xpath>
        </field>
    </record>

    <record id="product_attribute_view_form_resale_lines" model="ir.ui.view">
        <field name="name">product.attribute.form.resale.lines</field>
        <field name="model">product.attribute</field>
        <field name="inherit_id" ref="product.product_attribute_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='create_variant']" position="after">
                <field name="resale_show_on_lines"/>
            </xpath>
        </field>
    </record>
</odoo>
