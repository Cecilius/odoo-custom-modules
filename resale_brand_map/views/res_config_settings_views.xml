<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.resale.brand.map</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Brand Mapping" name="resale_brand_map" data-string="Brand Mapping">
                    <block title="Brand Attribute">
                        <setting id="brand_attribute" string="Brand Attribute"
                                 help="Choose which product attribute supplies the Brand dropdown.">
                            <field name="brand_attribute_id"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
