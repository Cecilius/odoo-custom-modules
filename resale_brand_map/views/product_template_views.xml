<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_template_form_brand_map" model="ir.ui.view">
        <field name="name">product.template.form.brand.map</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <field name="categ_id" position="after">
                <field name="brand_value_id"
                       widget="selection"
                       domain="[('attribute_id', '=', brand_attribute_id)]"
                       options="{'no_create': True}"/>
            </field>
            <xpath expr="//page[@name='variants']//field[@name='attribute_line_ids']" position="before">
                <field name="brand_attribute_id" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='variants']//field[@name='attribute_line_ids']" position="attributes">
                <attribute name="domain">[('attribute_id', '!=', brand_attribute_id)]</attribute>
            </xpath>
        </field>
    </record>
</odoo>
