<odoo>
    <record id="view_repair_order_form_repair_helpdesk_link" model="ir.ui.view">
        <field name="name">repair.order.form.repair.helpdesk.link</field>
        <field name="model">repair.order</field>
        <field name="inherit_id" ref="repair.view_repair_order_form"/>
        <field name="arch" type="xml">
            <!-- Show the originating helpdesk ticket on the repair order. -->
            <xpath expr="//field[@name='under_warranty']" position="after">
                <field name="helpdesk_ticket_id" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
