<odoo>
    <record id="view_helpdesk_team_form_repair_workflow" model="ir.ui.view">
        <field name="name">helpdesk.team.form.repair.workflow</field>
        <field name="model">helpdesk.team</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_team_view_form"/>
        <field name="arch" type="xml">
            <field name="description" position="after">
                <div class="row mt16 o_settings_container" id="repair_workflows">
                    <setting help="Use workflows and automations for a repair business">
                        <field name="x_repair_workflow_team" string="Repair workflow and automations "/>
                    </setting>
                </div>
            </field>
        </field>
    </record>
</odoo>
