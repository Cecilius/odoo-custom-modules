<odoo>
    <record id="view_helpdesk_ticket_form_repair_buttons" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.repair.buttons</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">

            <!-- Smart buttons in the native button box.
                 They appear only for repair tickets and only when linked records exist. -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_sale_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not x_is_repair_ticket or sale_order_count == 0">
                    <field name="sale_order_count" string="Quotations" widget="statinfo"/>
                </button>
                <button name="action_view_shipments"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-truck"
                        invisible="not x_is_repair_ticket or picking_count == 0">
                    <field name="picking_count" string="Shipments" widget="statinfo"/>
                </button>
                <button name="action_view_inspections"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-list"
                        invisible="not x_is_repair_ticket or inspection_count == 0">
                    <field name="inspection_count" string="Inspections" widget="statinfo"/>
                </button>
                <button name="action_view_repair_orders"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-wrench"
                        invisible="not x_is_repair_ticket or repair_order_count == 0">
                    <field name="repair_order_count" string="Repair Orders" widget="statinfo"/>
                </button>
                <button name="action_view_quality_controls"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-check-circle"
                        invisible="not x_is_repair_ticket or quality_control_count == 0">
                    <field name="quality_control_count" string="QC" widget="statinfo"/>
                </button>
                <button name="action_view_invoices"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-file-text-o"
                        invisible="not x_is_repair_ticket or invoice_count == 0">
                    <field name="invoice_count" string="Invoices" widget="statinfo"/>
                </button>
            </xpath>

            <!-- Header buttons used only to create the next business document. -->
            <xpath expr="//header" position="inside">
                <button name="action_create_quotation"
                        type="object"
                        string="Create Quotation"
                        class="btn-primary"
                        invisible="not x_can_create_quotation"/>
                <button name="action_revise_quotation"
                        type="object"
                        string="Revise Quotation"
                        invisible="not x_can_revise_quotation"/>
                <button name="action_create_repair_order"
                        type="object"
                        string="Create Repair Order"
                        invisible="not x_can_create_repair_order"/>
                <button name="action_create_incoming_picking"
                        type="object"
                        string="Create Incoming Shipment"
                        invisible="not x_can_create_incoming_picking"/>
                <button name="action_create_incoming_inspection"
                    type="object"
                    string="Create Inspection Checklist"
                    invisible="not x_can_create_incoming_inspection"/>
                <button name="action_create_outgoing_picking"
                        type="object"
                        string="Create Outgoing Shipment"
                        invisible="not x_can_create_outgoing_picking"/>
            </xpath>

            <!-- Extra ticket fields used by the repair workflow. -->
            <xpath expr="//sheet" position="inside">
                <group string="Repair Details" invisible="not x_is_repair_ticket">
                    <group>
                        <!-- Hidden counters kept on the form so client logic can read them if needed. -->
                        <field name="sale_order_count" invisible="1"/>
                        <field name="repair_order_count" invisible="1"/>
                        <field name="picking_count" invisible="1"/>
                        <field name="incoming_picking_count" invisible="1"/>
                        <field name="outgoing_picking_count" invisible="1"/>
                        <field name="quality_control_count" invisible="1"/>
                        <field name="invoice_count" invisible="1"/>
                    </group>
                    <group>
                        <field name="x_device_description"/>
                        <field name="x_serial_number"/>
                        <field name="x_reported_issue"/>
                        <field name="x_carrier_name"/>
                        <field name="x_tracking_reference"/>
                    </group>
                    <group string="Customer Reported" colspan="2">
                        <field name="x_reported_drop_damage"/>
                        <field name="x_reported_water_damage"/>
                        <field name="x_reported_contamination"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>

    <!-- Repair dashboard kanban view. -->
    <record id="helpdesk_ticket_view_kanban_repair" model="ir.ui.view">
        <field name="name">helpdesk.ticket.kanban.repair</field>
        <field name="model">helpdesk.ticket</field>
        <field name="priority">20</field>
        <field name="arch" type="xml">
            <kanban default_group_by="stage_id" quick_create="true" class="o_kanban_small_column">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="priority"/>
                <field name="stage_id"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="x_device_description"/>
                <field name="x_serial_number"/>
                <field name="inspection_status"/>
                <field name="repair_status"/>
                <field name="payment_status"/>
                <field name="x_can_create_incoming_inspection"/>
                <field name="x_can_create_repair_order"/>
                <field name="x_can_create_outgoing_picking"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card oe_kanban_global_click">
                            <div class="o_kanban_record_top">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                            </div>
                            <div class="o_kanban_record_body">
                                <div t-if="record.x_device_description.value or record.x_serial_number.value"
                                     class="text-muted small mb-1">
                                    <t t-if="record.x_device_description.value" t-esc="record.x_device_description.value"/>
                                    <span t-if="record.x_device_description.value and record.x_serial_number.value"
                                          class="mx-1 text-muted">—</span>
                                    <span t-if="record.x_serial_number.value"
                                          class="text-muted" t-esc="record.x_serial_number.value"/>
                                </div>
                                <div class="oe_kanban_status_flags small mb-1">
                                    <span t-if="record.inspection_status.raw_value == 'pass'" class="badge rounded-pill bg-success me-1"><t t-esc="record.inspection_status.value"/></span>
                                    <span t-if="record.inspection_status.raw_value == 'fail'" class="badge rounded-pill bg-danger me-1"><t t-esc="record.inspection_status.value"/></span>
                                    <span t-if="record.inspection_status.raw_value == 'draft'" class="badge rounded-pill bg-info me-1"><t t-esc="record.inspection_status.value"/></span>
                                    <span t-if="record.repair_status.raw_value == 'done'" class="badge rounded-pill bg-success me-1"><t t-esc="record.repair_status.value"/></span>
                                    <span t-if="record.repair_status.raw_value == 'qc'" class="badge rounded-pill bg-warning me-1"><t t-esc="record.repair_status.value"/></span>
                                    <span t-if="record.repair_status.raw_value == 'draft'" class="badge rounded-pill bg-info me-1"><t t-esc="record.repair_status.value"/></span>
                                    <span t-if="record.payment_status.raw_value == 'paid'" class="badge rounded-pill bg-success me-1"><t t-esc="record.payment_status.value"/></span>
                                    <span t-if="record.payment_status.raw_value == 'pending'" class="badge rounded-pill bg-warning me-1"><t t-esc="record.payment_status.value"/></span>
                                </div>
                                <div class="o_kanban_partner">
                                    <field name="partner_id"/>
                                </div>
                            </div>
                            <div class="o_kanban_bottom">
                                <div class="oe_kanban_bottom_left">
                                    <field name="priority" widget="priority"/>
                                </div>
                                <div class="oe_kanban_bottom_right">
                                    <field name="user_id"/>
                                </div>
                            </div>
                            <div class="oe_kanban_quick_actions" t-if="record.x_can_create_incoming_inspection.raw_value or record.x_can_create_repair_order.raw_value or record.x_can_create_outgoing_picking.raw_value">
                                <button t-if="record.x_can_create_incoming_inspection.raw_value"
                                        type="object" name="action_create_incoming_inspection"
                                        class="btn btn-sm btn-primary w-100 mt-1">Create Inspection</button>
                                <button t-if="record.x_can_create_repair_order.raw_value"
                                        type="object" name="action_create_repair_order"
                                        class="btn btn-sm btn-primary w-100 mt-1">Create Repair</button>
                                <button t-if="record.x_can_create_outgoing_picking.raw_value"
                                        type="object" name="action_create_outgoing_picking"
                                        class="btn btn-sm btn-primary w-100 mt-1">Create Shipment</button>
                            </div>
                        </div>
                    </t>
                    <t t-name="quick_create">
                        <div>
                            <field name="team_id" required="1" domain="[('x_repair_workflow_team','=',True)]"/>
                            <field name="name" required="1" placeholder="Describe the issue..."/>
                            <field name="partner_id"/>
                            <field name="x_device_description" placeholder="Device / Model"/>
                            <field name="x_serial_number" placeholder="Serial Number"/>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Repair dashboard search filters. -->
    <record id="helpdesk_ticket_search_repair" model="ir.ui.view">
        <field name="name">helpdesk.ticket.search.repair</field>
        <field name="model">helpdesk.ticket</field>
        <field name="arch" type="xml">
            <search>
                <filter name="my_tickets" string="My Tickets" domain="[('user_id','=',uid)]"/>
                <filter name="active" string="Active" domain="[('stage_id.fold','=',False)]"/>
                <separator/>
                <filter name="unassigned" string="Unassigned" domain="[('user_id','=',False)]"/>
            </search>
        </field>
    </record>

    <record id="action_helpdesk_ticket_repair_kanban" model="ir.actions.act_window">
        <field name="name">Repair Dashboard</field>
        <field name="res_model">helpdesk.ticket</field>
        <field name="view_mode">kanban,form</field>
        <field name="view_id" ref="helpdesk_ticket_view_kanban_repair"/>
        <field name="search_view_id" ref="helpdesk_ticket_search_repair"/>
        <field name="domain">[('team_id.x_repair_workflow_team', '=', True)]</field>
    </record>

    <menuitem id="menu_helpdesk_repair_kanban"
              name="Repair Dashboard"
              action="action_helpdesk_ticket_repair_kanban"
              parent="helpdesk.helpdesk_ticket_menu_main"
              sequence="1"/>
</odoo>
