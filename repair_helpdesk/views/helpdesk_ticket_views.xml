<odoo>
    <record id="view_helpdesk_ticket_form_repair_buttons" model="ir.ui.view">
        <field name="name">helpdesk.ticket.form.repair.buttons</field>
        <field name="model">helpdesk.ticket</field>
        <field name="inherit_id" ref="helpdesk.helpdesk_ticket_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="action_create_quotation"
                        type="object"
                        string="Create Quotation"
                        class="btn-primary"
                        invisible="not x_can_create_quotation"/>
                <button name="action_open_quotation"
                        type="object"
                        string="Open Quotation / Sale Order"
                        invisible="not x_can_open_quotation"/>
                <button name="action_create_repair_order"
                        type="object"
                        string="Create Repair Order"
                        invisible="not x_can_create_repair_order"/>
                <button name="action_open_repair_order"
                        type="object"
                        string="Open Repair Order"
                        invisible="not x_can_open_repair_order"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <group string="Repair Details" invisible="not x_is_repair_ticket">
                    <group>
                        <field name="sale_order_id" readonly="1"/>
                        <field name="repair_order_id" readonly="1"/>
                    </group>
                    <group>
                        <field name="x_device_description"/>
                        <field name="x_serial_number"/>
                        <field name="x_reported_issue"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
