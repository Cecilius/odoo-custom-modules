<odoo>
    <record id="view_inspection_image_tree" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.image.tree</field>
        <field name="model">repair_helpdesk.incoming_inspection.image</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="image" widget="image" nolabel="1"
                       options='{"zoom":true,"size":[0,90]}'/>
                <field name="description"/>
            </list>
        </field>
    </record>

    <record id="view_inspection_image_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.image.form</field>
        <field name="model">repair_helpdesk.incoming_inspection.image</field>
        <field name="arch" type="xml">
            <form string="Picture">
                <group>
                    <field name="image" widget="image" nolabel="1"
                           options='{"zoom":true}'/>
                    <field name="description" placeholder="What does this show?"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_inspection_image_kanban" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.image.kanban</field>
        <field name="model">repair_helpdesk.incoming_inspection.image</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_image_grid">
                <field name="image" widget="image"/>
                <templates>
                    <t t-name="kanban-box">
                        <div class="oe_kanban_card">
                            <field name="image" widget="image"
                                   options='{"size":[0,150],"zoom":true}'/>
                            <div class="oe_kanban_content">
                                <field name="description"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_repair_helpdesk_incoming_inspection_line_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.line.list</field>
        <field name="model">repair_helpdesk.incoming_inspection.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="result" widget="selection_badge"
                       decoration-success="result == 'pass'"
                       decoration-danger="result == 'fail'"
                       decoration-info="result == 'na'"/>
                <field name="comment" optional="show"/>
                <field name="image" optional="show" widget="image" options="{&quot;zoom&quot;:true,&quot;reload&quot;:true,&quot;size&quot;:[0,90]}"/>
            </list>
        </field>
    </record>

    <record id="view_repair_helpdesk_incoming_inspection_line_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.line.form</field>
        <field name="model">repair_helpdesk.incoming_inspection.line</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="result"/>
                    <field name="comment" widget="text"
                           placeholder="Required if failed — describe findings..."/>
                    <field name="image" widget="image" string="Picture" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_incoming_inspection_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.form</field>
        <field name="model">repair_helpdesk.incoming_inspection</field>
        <field name="arch" type="xml">
            <form string="Incoming Inspection">
                <header>
                    <button name="action_done" type="object" string="Complete Inspection"
                            class="btn-primary"
                            invisible="status == 'done' or not ticket_in_inspection_stage"/>
                    <button name="action_approve_for_repair" type="object" string="Approve for Repair"
                            invisible="status != 'done' or not has_failures or repair_approved"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="status != 'done'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_ref" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serial_number" readonly="1"/>
                            <field name="device_description" readonly="1"/>
                        </group>
                    </group>
                    <group string="Customer Reported (for reference)">
                        <group>
                            <field name="customer_reported_drop"/>
                        </group>
                        <group>
                            <field name="customer_reported_water"/>
                        </group>
                        <group>
                            <field name="customer_reported_contamination"/>
                        </group>
                    </group>
                    <group string="Reported Issue" readonly="status == 'done'">
                        <field name="customer_reported_issue" widget="text" nolabel="1"/>
                    </group>
                    <group string="Fault Confirmation" readonly="status == 'done'">
                        <field name="reported_fault_confirmed"/>
                        <field name="reported_fault_notes" widget="text"
                               placeholder="Describe findings about the reported fault..."/>
                    </group>
                    <group string="Notes">
                        <field name="inspection_note" placeholder="General inspection notes..."
                               readonly="status == 'done'"/>
                    </group>
                    <group string="Inspection Checklist">
                        <field name="line_ids"
                               readonly="status == 'done'"/>
                    </group>
                    <group string="General Pictures">
                        <field name="general_image_ids"
                               mode="kanban,tree,form"
                               context="{'tree_view_ref': 'repair_helpdesk.view_inspection_image_tree',
                                         'kanban_view_ref': 'repair_helpdesk.view_inspection_image_kanban',
                                         'form_view_ref': 'repair_helpdesk.view_inspection_image_form'}"/>
                    </group>
                    <group string="Approval for Repair" invisible="status != 'done' or not has_failures or repair_approved">
                        <field name="repair_approve_note"
                               placeholder="Enter the reason for approving this repair despite inspection failures..."
                               widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_incoming_inspection_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.list</field>
        <field name="model">repair_helpdesk.incoming_inspection</field>
        <field name="arch" type="xml">
            <list string="Incoming Inspections">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_repair_helpdesk_incoming_inspection" model="ir.actions.act_window">
        <field name="name">Incoming Inspections</field>
        <field name="res_model">repair_helpdesk.incoming_inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Create and review incoming inspection checklists for repair tickets.</p>
        </field>
    </record>
</odoo>
