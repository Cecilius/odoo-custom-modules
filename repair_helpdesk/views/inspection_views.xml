<odoo>
    <!-- Tree view for inspection checklist lines -->
    <record id="view_repair_helpdesk_incoming_inspection_line_tree" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.line.tree</field>
        <field name="model">repair_helpdesk.incoming_inspection.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="result" widget="badge" decoration-success="result == 'pass'" decoration-danger="result == 'fail'" decoration-info="result == 'na'"/>
                <field name="comment" optional="show"/>
            </tree>
        </field>
    </record>

    <!-- Form view for inspection checklist lines -->
    <record id="view_repair_helpdesk_incoming_inspection_line_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.line.form</field>
        <field name="model">repair_helpdesk.incoming_inspection.line</field>
        <field name="arch" type="xml">
            <form string="Checklist Item">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="result"/>
                    <field name="comment" widget="text" placeholder="Required if failed — describe findings..."/>
                    <field name="image" widget="image" string="Picture" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <!-- Form view for incoming inspection -->
    <record id="view_repair_helpdesk_incoming_inspection_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.form</field>
        <field name="model">repair_helpdesk.incoming_inspection</field>
        <field name="arch" type="xml">
            <form string="Incoming Inspection">
                <header>
                    <button name="action_done" type="object" string="Complete Inspection"
                            class="btn-primary" invisible="status == 'done'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_ref" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serial_number" readonly="1"/>
                            <field name="device_description" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="inspection_note" nolabel="1" placeholder="General inspection notes..."/>
                    </group>
                    <group string="Inspection Checklist">
                        <field name="line_ids"
                               context="{'tree_view_ref': 'repair_helpdesk.view_repair_helpdesk_incoming_inspection_line_tree',
                                         'form_view_ref': 'repair_helpdesk.view_repair_helpdesk_incoming_inspection_line_form'}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- List view for incoming inspections -->
    <record id="view_repair_helpdesk_incoming_inspection_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.list</field>
        <field name="model">repair_helpdesk.incoming_inspection</field>
        <field name="arch" type="xml">
            <list string="Incoming Inspections">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <!-- Action window -->
    <record id="action_repair_helpdesk_incoming_inspection" model="ir.actions.act_window">
        <field name="name">Incoming Inspections</field>
        <field name="res_model">repair_helpdesk.incoming_inspection</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (4, ref('view_repair_helpdesk_incoming_inspection_list')), (4, ref('view_repair_helpdesk_incoming_inspection_form'))]"/>
        <field name="help" type="html">
            <p>Create and review incoming inspection checklists for repair tickets.</p>
        </field>
    </record>
</odoo>
