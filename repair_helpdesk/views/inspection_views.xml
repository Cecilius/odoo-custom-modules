<odoo>
    <record id="view_repair_helpdesk_incoming_inspection_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.form</field>
        <field name="model">repair_helpdesk.incoming_inspection</field>
        <field name="arch" type="xml">
            <form string="Incoming Inspection">
                <sheet>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="ticket_ref" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serial_number" readonly="1"/>
                            <field name="device_description" readonly="1"/>
                            <field name="inspection_note" widget="text"/>
                            <field name="status"/>
                        </group>
                    </group>
                    <group>
                        <field name="line_ids">
                            <tree editable="bottom">
                                <field name="name" readonly="1"/>
                                <field name="result"/>
                                <field name="comment"/>
                            </tree>
                        </field>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_incoming_inspection_tree" model="ir.ui.view">
        <field name="name">repair_helpdesk.incoming_inspection.tree</field>
        <field name="model">repair_helpdesk.incoming_inspection</field>
        <field name="arch" type="xml">
            <tree string="Incoming Inspections">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="status"/>
            </tree>
        </field>
    </record>

    <record id="action_repair_helpdesk_incoming_inspection" model="ir.actions.act_window">
        <field name="name">Incoming Inspections</field>
        <field name="res_model">repair_helpdesk.incoming_inspection</field>
        <field name="view_mode">tree,form</field>
        <field name="view_ids" eval="[(5, 0, 0), (4, ref('view_repair_helpdesk_incoming_inspection_tree')), (4, ref('view_repair_helpdesk_incoming_inspection_form'))]"/>
        <field name="help" type="html">
            <p>Create and review incoming inspection checklists for repair tickets.</p>
        </field>
    </record>
</odoo>
