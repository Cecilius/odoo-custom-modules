<odoo>
    <record id="view_quality_control_image_kanban" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.image.kanban</field>
        <field name="model">repair_helpdesk.quality_control.image</field>
        <field name="arch" type="xml">
            <kanban class="o_kanban_image_grid">
                <field name="image" widget="image"/>
                <templates>
                    <t t-name="card">
                        <div class="oe_kanban_card">
                            <field name="image" widget="image"
                                   options='{"size":[0,150],"zoom":true}'/>
                            <div class="oe_kanban_content">
                                <field name="description"/>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <record id="view_quality_control_image_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.image.form</field>
        <field name="model">repair_helpdesk.quality_control.image</field>
        <field name="arch" type="xml">
            <form string="Picture">
                <group>
                    <field name="image" widget="image" nolabel="1"
                           options='{"zoom":true}'/>
                    <field name="description" placeholder="What does this show?"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_line_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.line.list</field>
        <field name="model">repair_helpdesk.quality_control.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="result" widget="selection_badge"
                       decoration-success="result == 'pass'"
                       decoration-danger="result == 'fail'"
                       decoration-info="result == 'na'"/>
                <field name="comment" optional="show"/>
                <field name="image" optional="show" widget="image" options="{&quot;zoom&quot;:true,&quot;reload&quot;:true,&quot;size&quot;:[0,90]}"/>
            </list>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_line_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.line.form</field>
        <field name="model">repair_helpdesk.quality_control.line</field>
        <field name="arch" type="xml">
            <form string="QC Checklist Item">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="result"/>
                    <field name="comment" widget="text"
                           placeholder="Required if failed — describe findings..."/>
                    <field name="image" widget="image" string="Picture" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.form</field>
        <field name="model">repair_helpdesk.quality_control</field>
        <field name="arch" type="xml">
            <form string="Quality Control">
                <header>
                    <button name="action_done" type="object" string="Complete QC"
                            class="btn-primary" invisible="status == 'done'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_ref" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serial_number" readonly="1"/>
                            <field name="device_description" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="QC Details">
                            <group string="Notes">
                                <field name="qc_note" placeholder="General QC notes..."
                                       readonly="status == 'done'"/>
                            </group>
                            <group string="QC Checklist">
                                <field name="line_ids"
                                       readonly="status == 'done'"/>
                            </group>
                            <group string="Pictures">
                                <field name="general_image_ids"
                                       mode="kanban,tree,form"
                                       context="{'tree_view_ref': 'repair_helpdesk.view_quality_control_image_tree',
                                                 'kanban_view_ref': 'repair_helpdesk.view_quality_control_image_kanban',
                                                 'form_view_ref': 'repair_helpdesk.view_quality_control_image_form'}"/>
                            </group>
                        </page>
                        <page string="Initial Inspection" invisible="not inspection_id">
                            <group string="Inspection" colspan="2">
                                <field name="inspection_id"/>
                            </group>
                            <group string="Fault Confirmation" colspan="2">
                                <field name="inspection_summary" widget="text" nolabel="1"/>
                            </group>
                            <group string="Inspection Pictures" invisible="not inspection_image_ids">
                                <field name="inspection_image_ids"
                                       mode="kanban,tree,form"
                                       context="{'tree_view_ref': 'repair_helpdesk.view_inspection_image_tree',
                                                 'kanban_view_ref': 'repair_helpdesk.view_inspection_image_kanban',
                                                 'form_view_ref': 'repair_helpdesk.view_inspection_image_form'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.list</field>
        <field name="model">repair_helpdesk.quality_control</field>
        <field name="arch" type="xml">
            <list string="Quality Controls">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_repair_helpdesk_quality_control" model="ir.actions.act_window">
        <field name="name">Quality Controls</field>
        <field name="res_model">repair_helpdesk.quality_control</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Review quality control checklists for repair tickets.</p>
        </field>
    </record>
</odoo>
