<odoo>
    <record id="view_repair_helpdesk_quality_control_line_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.line.list</field>
        <field name="model">repair_helpdesk.quality_control.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="result" widget="selection_badge"
                       decoration-success="result == 'pass'"
                       decoration-danger="result == 'fail'"
                       decoration-info="result == 'na'"/>
                <field name="comment" optional="show"/>
                <field name="image" optional="show" widget="image" options="{&quot;zoom&quot;:true,&quot;reload&quot;:true,&quot;size&quot;:[0,90]}"/>
            </list>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_line_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.line.form</field>
        <field name="model">repair_helpdesk.quality_control.line</field>
        <field name="arch" type="xml">
            <form string="QC Checklist Item">
                <group>
                    <field name="name" readonly="1"/>
                    <field name="result"/>
                    <field name="comment" widget="text"
                           placeholder="Required if failed — describe findings..."/>
                    <field name="image" widget="image" string="Picture" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_form" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.form</field>
        <field name="model">repair_helpdesk.quality_control</field>
        <field name="arch" type="xml">
            <form string="Quality Control">
                <header>
                    <button name="action_done" type="object" string="Complete QC"
                            class="btn-primary" invisible="status == 'done'"/>
                    <field name="status" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="ticket_ref" readonly="1"/>
                            <field name="partner_id" readonly="1"/>
                        </group>
                        <group>
                            <field name="serial_number" readonly="1"/>
                            <field name="device_description" readonly="1"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="qc_note" placeholder="General QC notes..."
                               readonly="status == 'done'"/>
                    </group>
                    <group string="QC Checklist">
                        <field name="line_ids"
                               readonly="status == 'done'"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_repair_helpdesk_quality_control_list" model="ir.ui.view">
        <field name="name">repair_helpdesk.quality_control.list</field>
        <field name="model">repair_helpdesk.quality_control</field>
        <field name="arch" type="xml">
            <list string="Quality Controls">
                <field name="name"/>
                <field name="ticket_ref"/>
                <field name="partner_id"/>
                <field name="status"/>
            </list>
        </field>
    </record>

    <record id="action_repair_helpdesk_quality_control" model="ir.actions.act_window">
        <field name="name">Quality Controls</field>
        <field name="res_model">repair_helpdesk.quality_control</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p>Review quality control checklists for repair tickets.</p>
        </field>
    </record>
</odoo>
