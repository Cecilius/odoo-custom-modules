<odoo>
    <data noupdate="1">
        <record id="quality_point_repairs_incoming_drop_damage" model="quality.point">
            <field name="name">Incoming Inspection - Device condition and accessories</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="picking_type_ids" eval="[(4, ref('stock.picking_type_in'))]"/>
            <field name="test_type_id" ref="quality.test_type_picture"/>
            <field name="note">Inspect the device for drop damage, water damage, contamination, missing or damaged accessories, and visible cosmetic issues. Attach photos or comments as needed.</field>
            <field name="sequence">10</field>
        </record>

        <record id="quality_point_repairs_incoming_water_damage" model="quality.point">
            <field name="name">Incoming Inspection - Water damage</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="picking_type_ids" eval="[(4, ref('stock.picking_type_in'))]"/>
            <field name="test_type_id" ref="quality.test_type_instructions"/>
            <field name="note">Inspect for signs of liquid ingress, corrosion, moisture residue, or water stains on connectors and boards.</field>
            <field name="sequence">20</field>
            <field name="active">False</field>
        </record>

        <record id="quality_point_repairs_incoming_contamination" model="quality.point">
            <field name="name">Incoming Inspection - Contamination</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="picking_type_ids" eval="[(4, ref('stock.picking_type_in'))]"/>
            <field name="test_type_id" ref="quality.test_type_instructions"/>
            <field name="note">Inspect for excess dirt, dust, grease, or other contaminants that may affect repair or operation.</field>
            <field name="sequence">30</field>
            <field name="active">False</field>
        </record>

        <record id="quality_point_repairs_incoming_accessories" model="quality.point">
            <field name="name">Incoming Inspection - Accessories</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="picking_type_ids" eval="[(4, ref('stock.picking_type_in'))]"/>
            <field name="test_type_id" ref="quality.test_type_instructions"/>
            <field name="note">Check included accessories and documentation, and add any notes on missing or damaged items.</field>
            <field name="sequence">40</field>
            <field name="active">False</field>
        </record>

        <record id="quality_point_repairs_incoming_visible_damage" model="quality.point">
            <field name="name">Incoming Inspection - Visible damages</field>
            <field name="team_id" ref="quality.quality_alert_team0"/>
            <field name="company_id" ref="base.main_company"/>
            <field name="picking_type_ids" eval="[(4, ref('stock.picking_type_in'))]"/>
            <field name="test_type_id" ref="quality.test_type_picture"/>
            <field name="note">Take pictures and document visible damage, scratches, dents, screen condition, and other cosmetic issues.</field>
            <field name="sequence">50</field>
            <field name="active">False</field>
        </record>
    </data>
</odoo>
