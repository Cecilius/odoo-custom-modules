<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="resale_ai_manufacturer_wizard_view_form" model="ir.ui.view">
        <field name="name">resale.ai.manufacturer.wizard.form</field>
        <field name="model">resale.ai.manufacturer.wizard</field>
        <field name="arch" type="xml">
            <form string="Find GPSR Compliance Info">
                <div invisible="state not in ('draft', 'error')" class="w-100">
                    <separator string="Product information sent to AI"/>
                    <field name="product_display" readonly="1" widget="text" nolabel="1" class="w-100 mb-2"/>
                    <div invisible="state != 'error'" class="mb-3">
                        <separator string="Status"/>
                        <field name="error_message" readonly="1" widget="text" nolabel="1" class="text-danger w-100"/>
                    </div>
                    <div class="mb-3">
                        <button name="action_generate" type="object" string="Generate GPSR Info" class="btn-primary"/>
                    </div>
                </div>

                <div invisible="state not in ('result', 'done')" class="w-100">
                    <div invisible="same_company_note == False" class="mb-3">
                        <separator string="Same company check"/>
                        <field name="same_company_note" readonly="1" widget="text" nolabel="1" class="text-info w-100"/>
                    </div>

                    <!-- Manufacturer -->
                    <separator string="Manufacturer contact"/>
                    <field name="manufacturer_action" class="w-100 mb-2"/>
                    <field name="manufacturer_note" readonly="1" widget="text" nolabel="1"
                           class="w-100 mb-2"/>
                    <field name="manufacturer_use_partner_id" class="w-100 mb-2"
                           invisible="manufacturer_action != 'use_existing'"/>
                    <group invisible="manufacturer_action != 'create'" col="2">
                        <field name="m_name"/>
                        <field name="m_country_id"/>
                        <field name="m_street"/>
                        <field name="m_city"/>
                        <field name="m_zip"/>
                        <field name="m_email"/>
                        <field name="m_phone"/>
                        <field name="m_website"/>
                    </group>

                    <!-- EU Responsible Person -->
                    <separator string="EU Responsible Person"/>
                    <field name="eu_responsible_action" class="w-100 mb-2"/>
                    <field name="eu_responsible_note" readonly="1" widget="text" nolabel="1"
                           class="w-100 mb-2"/>
                    <field name="eu_responsible_use_partner_id" class="w-100 mb-2"
                           invisible="eu_responsible_action != 'use_existing'"/>
                    <group invisible="eu_responsible_action != 'create'" col="2">
                        <field name="r_name"/>
                        <field name="r_country_id"/>
                        <field name="r_street"/>
                        <field name="r_city"/>
                        <field name="r_zip"/>
                        <field name="r_email"/>
                        <field name="r_phone"/>
                        <field name="r_website"/>
                    </group>

                    <separator string="CE Compliance"/>
                    <field name="ce_compliance" widget="text" nolabel="1" class="w-100 mb-2"/>
                    <separator string="Safety Record"/>
                    <field name="safety_record" widget="text" nolabel="1" class="w-100 mb-2"/>
                </div>

                <footer>
                    <button name="action_apply" type="object" string="Apply to Product"
                            class="btn-primary" invisible="state != 'result'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
