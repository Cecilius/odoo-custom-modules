<?xml version="1.0" encoding="UTF-8"?>
<templates id="pos_custom_receipt_templates" xml:space="preserve">

    <!-- A) Extend OrderReceipt (footers, labels, etc.) -->
    <t t-name="pos_custom_receipt.OrderReceipt"
       t-inherit="point_of_sale.OrderReceipt"
       t-inherit-mode="extension">

        <!-- 1) REMOVE the 'Powered by Odoo' line -->
        <xpath expr="//div[hasclass('pos-receipt-order-data') and hasclass('text-center')]" position="replace">
            <!-- empty: removes the node -->
        </xpath>

        <!-- 2) APPEND extra content before the '.before-footer' hook -->
        <xpath expr="//div[hasclass('before-footer')]" position="before">
            <div class="pos-receipt-order-data text-start pt-2" style="font-size: 75%;">
                <span>This simplified invoice does not replace the full invoice when required.</span>
            </div>
        </xpath>

        <!-- 3) Insert company name -->
        <xpath expr="//div[@class='pos-config-name']" position="after">
            <div class="company-name" t-out="company.name"/>
        </xpath>

        <!-- 4) Insert NIF -->
        <xpath expr="//div[@class='w-50 text-break text-start' and contains(@style, 'font-size: 75%')]" position="inside">
            <div class="company-company-registry" t-out="'NIF: ' + company.company_registry"/>
        </xpath>

        <!-- 5) Append something at the very end of the receipt -->
        <xpath expr="//div[hasclass('pos-receipt')]" position="inside">
            <div class="pos-receipt-order-data text-center pt-2" style="font-size: 70%;">
                <span>Thank you for your visit!</span>
            </div>
        </xpath>

        <!-- 6) put link under the QR code instead of next to it -->
        <xpath expr="//div[@t-if='order.company.point_of_sale_use_ticket_qr_code and order.finalized']" position="attributes">
            <attribute name="class" remove="flex-row" add="flex-column align-items-center text-center" separator=" "/>
        </xpath>
        <xpath expr="//div[@t-if='order.company.point_of_sale_use_ticket_qr_code and order.finalized']/div[hasclass('w-100')]" position="attributes">
            <attribute name="class" remove="ms-1" separator=" "/>
        </xpath>

        <!-- 7) Replace VAT with IVA in a tax subtotal -->
        <xpath expr="//span[@t-esc='tax_group.group_name']" position="replace">
            <span t-esc="tax_group.group_name &amp;&amp; tax_group.group_name.includes('VAT')
                ? tax_group.group_name.replace('VAT', 'IVA')
                : tax_group.group_name"/>
        </xpath>

    </t>

    <!-- B) Extend ReceiptHeader: add “Simplified invoice” but keep everything else -->
    <t t-name="pos_custom_receipt.ReceiptHeader"
       t-inherit="point_of_sale.ReceiptHeader"
       t-inherit-mode="extension">

        <!-- 1) Insert label inside the top centered header block -->
        <xpath expr="//div[hasclass('text-center')][@style and contains(@style, 'font-size: 75%')]/*[1]" position="before">
            <div class="simplified-invoice" style="font-size: 150%; font-weight: bold; text-align: center;">Simplified invoice</div>
        </xpath>

        <!-- 2) Delete prefix of the simplified invoice "VAT Ticket" -->
        <xpath expr="//span[contains(concat(' ', normalize-space(@class), ' '), ' ticket-name-prefix ')]" position="replace">
            <!-- empty: removes the node -->
        </xpath>

    </t>

</templates>