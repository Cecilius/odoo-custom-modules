<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="google_model_view_list" model="ir.ui.view">
        <field name="name">ai.google.model.view.list</field>
        <field name="model">ai.google.model</field>
        <field name="arch" type="xml">
            <list string="Allowed Google Gemini Models" editable="bottom">
                <field name="allowed" widget="boolean_toggle"/>
                <field name="api_mode"/>
                <field name="name"/>
                <field name="model_id"/>
                <field name="input_token_limit"/>
                <field name="output_token_limit"/>
                <field name="supported_generation_methods" optional="hide"/>
                <field name="last_seen" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="google_model_view_form" model="ir.ui.view">
        <field name="name">ai.google.model.view.form</field>
        <field name="model">ai.google.model</field>
        <field name="arch" type="xml">
            <form string="Google Gemini Model">
                <sheet>
                    <div class="oe_title">
                        <label for="name"/>
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <field name="allowed"/>
                        <field name="api_mode"/>
                        <field name="model_id" readonly="1"/>
                        <field name="input_token_limit" readonly="1"/>
                        <field name="output_token_limit" readonly="1"/>
                        <field name="last_seen" readonly="1"/>
                    </group>
                    <group>
                        <field name="description" readonly="1"/>
                        <field name="supported_generation_methods" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
