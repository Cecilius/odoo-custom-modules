<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ai.google.ai.studio</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ai_app.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='google_provider']" position="replace">
                <setting id="google_provider" string="Use your own Google Gemini account" help="Provide your API key to connect with your account" groups="base.group_system">
                    <field name="google_key_enabled"/>
                    <group invisible="not google_key_enabled">
                        <div class="flex-grow-1">
                            <field name="google_key" placeholder="Key" password="True" nolabel="1" class="w-100"/>
                        </div>
                        <button name="action_sync_google_models" type="object" string="Synchronize available models" class="btn-link" icon="fa-refresh"/>
                        <button name="action_open_google_models" type="object" string="Manage allowed models" class="btn-link" icon="fa-list"/>
                    </group>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
