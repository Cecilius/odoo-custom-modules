<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_ai_intake_wizard_form" model="ir.ui.view">
        <field name="name">resale.ai.intake.wizard.form</field>
        <field name="model">resale.ai.intake.wizard</field>
        <field name="arch" type="xml">
            <form string="AI Item Intake">
                <header>
                    <button name="action_open_identifier_popup" string="AI Lookup" type="object" class="oe_highlight" invisible="state not in ('input', 'error')"/>
                    <button name="action_reset_input" string="Back to Input" type="object" invisible="state != 'error'"/>
                    <button name="action_open_research_popup" string="Research Selected Fields" type="object" invisible="state != 'review'"/>
                    <button name="action_research_with_answers" string="Research with Answers" type="object" invisible="state != 'review' or not follow_up_questions"/>
                    <button name="action_confirm_next" string="Confirm &amp; Next" type="object" class="oe_highlight" invisible="state != 'review'"/>
                    <field name="state" widget="statusbar" statusbar_visible="input,review,error"/>
                </header>
                <sheet>
                    <group>
                        <field name="batch_id" readonly="1"/>
                        <field name="item_count" readonly="1"/>
                        <field name="planned_rfb" readonly="1"/>
                        <field name="last_rfb" readonly="1"/>
                        <field name="last_product_id" readonly="1"/>
                    </group>
                    <group string="Last Lookup">
                        <field name="input_ean" readonly="1"/>
                        <field name="input_asin" readonly="1"/>
                        <field name="input_search_text" readonly="1"/>
                    </group>
                    <group string="Lookup Result" invisible="state != 'review'">
                        <field name="result_name"/>
                        <field name="result_model"/>
                        <field name="result_brand_name"/>
                        <field name="brand_value_id" domain="[('resale_is_brand', '=', True)]"/>
                        <field name="result_category_path" readonly="1"/>
                        <field name="category_id" domain="[('rfb_prefix', '!=', False)]"/>
                        <field name="result_asin" readonly="1"/>
                        <field name="result_ean" readonly="1"/>
                        <field name="current_price"/>
                        <field name="lowest_price_180"/>
                        <field name="currency_id" readonly="1"/>
                        <field name="confidence" readonly="1"/>
                        <field name="agent_id" readonly="1"/>
                        <field name="changed_fields" readonly="1"/>
                    </group>
                    <group string="Sources" invisible="state != 'review'">
                        <field name="sources" readonly="1" nolabel="1"/>
                        <field name="raw_agent_response" readonly="1" nolabel="1"/>
                    </group>
                    <group string="Additional Identification Questions" invisible="state != 'review' or not follow_up_questions">
                        <field name="identifier_verification" readonly="1" nolabel="1"/>
                        <field name="follow_up_questions" readonly="1" nolabel="1"/>
                        <field name="follow_up_answers" placeholder="Answer one question per line" nolabel="1"/>
                    </group>
                    <group string="Error" invisible="state != 'error'">
                        <field name="error_message" readonly="1" nolabel="1"/>
                        <field name="raw_agent_response" readonly="1" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>
