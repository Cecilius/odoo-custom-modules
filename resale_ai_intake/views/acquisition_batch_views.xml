<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_acquisition_batch_form_ai_intake" model="ir.ui.view">
        <field name="name">resale.acquisition.batch.form.ai.intake</field>
        <field name="model">resale.acquisition.batch</field>
        <field name="inherit_id" ref="resale.view_resale_acquisition_batch_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_receive']" position="after">
                <button name="action_open_ai_intake" string="AI Item Intake" type="object" class="btn-secondary" invisible="state in ('locked', 'done')"/>
            </xpath>
        </field>
    </record>
</odoo>
