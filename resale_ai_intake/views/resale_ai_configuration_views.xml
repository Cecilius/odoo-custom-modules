<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_ai_configuration_list" model="ir.ui.view">
        <field name="name">resale.ai.configuration.list</field>
        <field name="model">resale.ai.configuration</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="primary_agent_id"/>
                <field name="fallback_agent_id"/>
                <field name="secondary_agent_id"/>
                <field name="confidence_threshold"/>
                <field name="automatic_fallback"/>
            </list>
        </field>
    </record>

    <record id="view_resale_ai_configuration_form" model="ir.ui.view">
        <field name="name">resale.ai.configuration.form</field>
        <field name="model">resale.ai.configuration</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="primary_agent_id"/>
                        <field name="fallback_agent_id"/>
                        <field name="secondary_agent_id"/>
                    </group>
                    <group string="Routing">
                        <field name="confidence_threshold"/>
                        <field name="automatic_fallback"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_ai_configuration" model="ir.actions.act_window">
        <field name="name">AI Intake Settings</field>
        <field name="res_model">resale.ai.configuration</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
