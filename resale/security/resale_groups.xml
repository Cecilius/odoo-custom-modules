<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="module_category_resale" model="ir.module.category">
        <field name="name">Resale</field>
        <field name="sequence">50</field>
    </record>

    <record id="res_groups_privilege_resale_user" model="res.groups.privilege">
        <field name="name">Resale User</field>
        <field name="category_id" ref="module_category_resale"/>
    </record>

    <record id="res_groups_privilege_resale_manager" model="res.groups.privilege">
        <field name="name">Resale Manager</field>
        <field name="category_id" ref="module_category_resale"/>
    </record>

    <record id="group_resale_user" model="res.groups">
        <field name="name">Resale User</field>
        <field name="privilege_id" ref="res_groups_privilege_resale_user"/>
        <field name="implied_ids" eval="[
            Command.link(ref('base.group_user')),
            Command.link(ref('product.group_product_manager')),
            Command.link(ref('stock.group_stock_user')),
            Command.link(ref('sales_team.group_sale_salesman')),
        ]"/>
    </record>

    <record id="group_resale_manager" model="res.groups">
        <field name="name">Resale Manager</field>
        <field name="privilege_id" ref="res_groups_privilege_resale_manager"/>
        <field name="implied_ids" eval="[
            Command.link(ref('group_resale_user')),
            Command.link(ref('stock.group_stock_manager')),
            Command.link(ref('sales_team.group_sale_manager')),
        ]"/>
    </record>
</odoo>
