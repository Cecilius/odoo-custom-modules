<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="condition_like_new" model="resale.condition">
            <field name="name">Like New</field>
            <field name="code">LN</field>
            <field name="sequence">10</field>
            <field name="condition_factor">1.0</field>
            <field name="functional_warranty" eval="True"/>
        </record>
        <record id="condition_very_good" model="resale.condition">
            <field name="name">Very Good</field>
            <field name="code">VG</field>
            <field name="sequence">20</field>
            <field name="condition_factor">0.9</field>
            <field name="functional_warranty" eval="True"/>
        </record>
        <record id="condition_good" model="resale.condition">
            <field name="name">Good</field>
            <field name="code">GD</field>
            <field name="sequence">30</field>
            <field name="condition_factor">0.75</field>
            <field name="functional_warranty" eval="True"/>
        </record>
        <record id="condition_with_imperfection" model="resale.condition">
            <field name="name">With Imperfection</field>
            <field name="code">WI</field>
            <field name="sequence">40</field>
            <field name="condition_factor">0.55</field>
            <field name="functional_warranty" eval="True"/>
        </record>
        <record id="condition_for_parts" model="resale.condition">
            <field name="name">For Parts / Not Working</field>
            <field name="code">FP</field>
            <field name="sequence">50</field>
            <field name="condition_factor">0.2</field>
            <field name="functional_warranty" eval="False"/>
            <field name="is_for_parts" eval="True"/>
        </record>
    </data>
</odoo>
