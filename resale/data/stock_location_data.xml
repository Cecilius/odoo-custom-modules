        <record id="location_resale_stock" model="stock.location">
            <field name="name">Resale Stock</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
            <field name="usage">internal</field>
            <field name="company_id" ref="base.main_company"/>
        </record>

        <record id="location_resale_scrap" model="stock.location">
            <field name="name">Resale Scrap</field>
            <field name="location_id" ref="stock.stock_location_stock"/>
