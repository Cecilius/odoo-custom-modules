<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="warranty_36_months" model="resale.warranty.policy">
            <field name="name">36 Months New</field>
            <field name="code">NEW36</field>
            <field name="duration_months">36</field>
            <field name="has_functional_warranty" eval="True"/>
            <field name="sequence">10</field>
        </record>
        <record id="warranty_12_months" model="resale.warranty.policy">
            <field name="name">12 Months Second-Hand</field>
            <field name="code">SH12</field>
            <field name="duration_months">12</field>
            <field name="has_functional_warranty" eval="True"/>
            <field name="sequence">20</field>
        </record>
        <record id="warranty_no_functional" model="resale.warranty.policy">
            <field name="name">No Functional Warranty</field>
            <field name="code">NFW</field>
            <field name="duration_months">0</field>
            <field name="has_functional_warranty" eval="False"/>
            <field name="sequence">30</field>
        </record>
        <record id="warranty_service_3_months" model="resale.warranty.policy">
            <field name="name">Service Warranty - 3 Months</field>
            <field name="code">SRV3</field>
            <field name="duration_months">3</field>
            <field name="has_functional_warranty" eval="True"/>
            <field name="sequence">40</field>
        </record>
    </data>
</odoo>
