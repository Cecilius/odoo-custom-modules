<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <record id="product_attribute_condition_grade" model="product.attribute">
            <field name="name">Condition Grade</field>
            <field name="create_variant">no_variant</field>
            <field name="display_type">select</field>
            <field name="sequence">5</field>
        </record>

        <record id="product_attribute_value_condition_new" model="product.attribute.value">
            <field name="name">New</field>
            <field name="attribute_id" ref="product_attribute_condition_grade"/>
            <field name="sequence">5</field>
            <field name="resale_condition_id" ref="condition_new"/>
            <field name="resale_warranty_policy_id" ref="warranty_36_months"/>
            <field name="resale_condition_factor">1.0</field>
            <field name="resale_is_condition_grade" eval="True"/>
        </record>
        <record id="product_attribute_value_condition_like_new" model="product.attribute.value">
            <field name="name">Like New</field>
            <field name="attribute_id" ref="product_attribute_condition_grade"/>
            <field name="sequence">10</field>
            <field name="resale_condition_id" ref="condition_like_new"/>
            <field name="resale_warranty_policy_id" ref="warranty_12_months"/>
            <field name="resale_condition_factor">1.0</field>
            <field name="resale_is_condition_grade" eval="True"/>
        </record>
        <record id="product_attribute_value_condition_very_good" model="product.attribute.value">
            <field name="name">Very Good</field>
            <field name="attribute_id" ref="product_attribute_condition_grade"/>
            <field name="sequence">20</field>
            <field name="resale_condition_id" ref="condition_very_good"/>
            <field name="resale_warranty_policy_id" ref="warranty_12_months"/>
            <field name="resale_condition_factor">0.9</field>
            <field name="resale_is_condition_grade" eval="True"/>
        </record>
        <record id="product_attribute_value_condition_good" model="product.attribute.value">
            <field name="name">Good</field>
            <field name="attribute_id" ref="product_attribute_condition_grade"/>
            <field name="sequence">30</field>
            <field name="resale_condition_id" ref="condition_good"/>
            <field name="resale_warranty_policy_id" ref="warranty_12_months"/>
            <field name="resale_condition_factor">0.75</field>
            <field name="resale_is_condition_grade" eval="True"/>
        </record>
        <record id="product_attribute_value_condition_imperfection" model="product.attribute.value">
            <field name="name">With Imperfection</field>
            <field name="attribute_id" ref="product_attribute_condition_grade"/>
            <field name="sequence">40</field>
            <field name="resale_condition_id" ref="condition_with_imperfection"/>
            <field name="resale_warranty_policy_id" ref="warranty_12_months"/>
            <field name="resale_condition_factor">0.55</field>
            <field name="resale_is_condition_grade" eval="True"/>
        </record>
        <record id="product_attribute_value_condition_for_parts" model="product.attribute.value">
            <field name="name">Not Working / For Spare Parts</field>
            <field name="attribute_id" ref="product_attribute_condition_grade"/>
            <field name="sequence">50</field>
            <field name="resale_condition_id" ref="condition_for_parts"/>
            <field name="resale_warranty_policy_id" ref="warranty_no_functional"/>
            <field name="resale_condition_factor">0.2</field>
            <field name="resale_is_for_parts" eval="True"/>
            <field name="resale_is_condition_grade" eval="True"/>
        </record>

        <function model="product.template" name="_ensure_default_condition_grade_all"/>
        <function model="product.product" name="_ensure_generic_warranty_all"/>
    </data>
</odoo>
