<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_brand_tree" model="ir.ui.view">
        <field name="name">resale.brand.tree</field>
        <field name="model">resale.brand</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="name"/>
                <field name="is_fallback" optional="show"/>
                <field name="website_visible" optional="show"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_resale_brand_form" model="ir.ui.view">
        <field name="name">resale.brand.form</field>
        <field name="model">resale.brand</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="is_fallback"/>
                        <field name="website_visible"/>
                        <field name="aliases"/>
                        <field name="note"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_brand" model="ir.actions.act_window">
        <field name="name">Brands</field>
        <field name="res_model">resale.brand</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
