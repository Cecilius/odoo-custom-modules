<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_product_tree" model="ir.ui.view">
        <field name="name">resale.product.tree</field>
        <field name="model">product.product</field>
        <field name="arch" type="xml">
            <list>
                <field name="rfb"/>
                <field name="name"/>
                <field name="categ_id"/>
                <field name="resale_brand_id"/>
                <field name="condition_id"/>
                <field name="resale_state"/>
                <field name="list_price"/>
                <field name="acquisition_cost"/>
                <field name="cost_status"/>
            </list>
        </field>
    </record>

    <record id="view_resale_product_form" model="ir.ui.view">
        <field name="name">resale.product.form</field>
        <field name="model">product.product</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_complete_evaluation" string="Complete Evaluation" type="object" class="oe_highlight" invisible="eval_done or resale_state in ('sold','scrapped','dismantled')"/>
                    <button name="action_start_detailed_test" string="Start Detailed Test" type="object" invisible="resale_state in ('received','sold','scrapped','dismantled')"/>
                    <button name="action_open_standard_product" string="Standard Product" type="object" icon="fa-external-link"/>
                    <field name="resale_state" widget="statusbar" statusbar_visible="received,inspecting,needs_repair,needs_dismantling,ready,published,reserved,sold"/>
                </header>
                <sheet>
                    <field name="image_1920" widget="image" class="oe_avatar" options="{'preview_image': 'image_128'}"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="Product name"/></h1>
                        <h2><field name="rfb" readonly="1"/></h2>
                    </div>
                    <group>
                        <group string="Identity">
                            <field name="categ_id" required="1"/>
                            <field name="brand_value_id" domain="[('resale_is_brand', '=', True)]"/>
                            <field name="barcode" readonly="1"/>
                            <field name="default_code" readonly="1"/>
                            <field name="batch_id"/>
                            <field name="type" invisible="1"/>
                            <field name="is_storable" invisible="1"/>
                        </group>
                        <group string="Pricing">
                            <field name="min_price"/>
                            <field name="recommended_price"/>
                            <field name="list_price" string="Approved Price"/>
                            <field name="acquisition_cost" readonly="cost_status in ('locked','legacy_locked')"/>
                            <field name="cost_status" readonly="cost_status in ('locked','legacy_locked')"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Identification">
                            <group>
                                <field name="asin"/>
                                <field name="upc"/>
                                <field name="manufacturer_serial"/>
                                <field name="amazon_es_url" widget="url"/>
                                <field name="amazon_uk_url" widget="url"/>
                                <field name="camel_url" widget="url"/>
                            </group>
                        </page>
                        <page string="Initial Evaluation">
                            <group>
                                <field name="eval_done" readonly="1"/>
                                <field name="eval_date" readonly="1"/>
                                <field name="eval_user_id" readonly="1"/>
                                <field name="condition_grade_value_id" domain="[('resale_is_condition_grade', '=', True)]"/>
                                <field name="functional_status"/>
                                <field name="completeness"/>
                                <field name="eval_basic_result"/>
                                <field name="eval_disposition"/>
                                <field name="eval_comment"/>
                            </group>
                        </page>
                        <page string="Condition &amp; Value">
                            <group>
                                <field name="initial_value"/>
                                <field name="condition_factor"/>
                                <field name="functional_factor"/>
                                <field name="completeness_factor"/>
                                <field name="adjusted_value"/>
                                <field name="photos_done"/>
                            </group>
                        </page>
                        <page string="Warranty">
                            <group>
                                <field name="warranty_policy_id" readonly="1"/>
                                <field name="warranty_start"/>
                                <field name="warranty_end"/>
                            </group>
                        </page>
                        <page string="Detailed Tests">
                            <field name="detailed_test_ids" context="{'default_product_id': id}">
                                <list>
                                    <field name="name"/>
                                    <field name="date"/>
                                    <field name="state"/>
                                    <field name="result"/>
                                    <field name="final_disposition"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_resale_product" model="ir.actions.act_window">
        <field name="name">Resale Items</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">list,form</field>
        <field name="view_ids" eval="[
            (5, 0, 0),
            (0, 0, {'view_mode': 'list', 'view_id': ref('view_resale_product_tree')}),
            (0, 0, {'view_mode': 'form', 'view_id': ref('view_resale_product_form')}),
        ]"/>
        <field name="domain">[('rfb', '!=', False)]</field>
        <field name="context" eval="{
            'default_type': 'consu',
            'default_is_storable': True,
            'default_resale_state': 'received',
            'default_categ_id': ref('product_category_other'),
        }"/>
    </record>
</odoo>
