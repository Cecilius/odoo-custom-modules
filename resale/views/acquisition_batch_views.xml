<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_acquisition_batch_tree" model="ir.ui.view">
        <field name="name">resale.acquisition.batch.tree</field>
        <field name="model">resale.acquisition.batch</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="partner_id"/>
                <field name="source_ref"/>
                <field name="acquisition_date"/>
                <field name="expected_items"/>
                <field name="received_items"/>
                <field name="allocable_cost"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="view_resale_acquisition_batch_form" model="ir.ui.view">
        <field name="name">resale.acquisition.batch.form</field>
        <field name="model">resale.acquisition.batch</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_receive" string="Receive" type="object" class="oe_highlight" invisible="state in ('received', 'allocating', 'locked', 'done')"/>
                    <button name="action_receive_stock" string="Receive into Stock" type="object" class="oe_highlight" invisible="state != 'received'"/>
                    <button name="action_sync_bills" string="Sync Bills" type="object" invisible="state in ('locked', 'done')"/>
                    <button name="action_calculate_allocation" string="Calculate Allocation" type="object" class="oe_highlight" invisible="state not in ('received', 'allocating')"/>
                    <button name="action_lock_costs" string="Lock Costs" type="object" invisible="state != 'allocating'"/>
                    <button name="action_done" string="Close Batch" type="object" invisible="state != 'locked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="ordered,awaiting,received,allocating,locked,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                            <field name="source_ref"/>
                        </group>
                        <group>
                            <field name="acquisition_date"/>
                            <field name="expected_arrival"/>
                            <field name="received_date"/>
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="tax_regime"/>
                        </group>
                    </group>
                    <group>
                        <field name="expected_items"/>
                        <field name="received_items"/>
                        <field name="item_variance"/>
                        <field name="allocable_cost"/>
                        <field name="total_cash"/>
                    </group>
                    <notebook>
                        <page string="Items">
                            <field name="item_ids" context="{'default_type': 'consu', 'default_is_storable': True, 'default_resale_state': 'received'}">
                                <list editable="bottom">
                                    <button name="action_open_resale_item" type="object" icon="fa-external-link" title="Open item"/>
                                    <field name="name"/>
                                    <field name="categ_id"/>
                                    <field name="rfb" optional="show" readonly="1"/>
                                    <field name="brand_value_id" optional="show" domain="[('resale_is_brand', '=', True)]"/>
                                    <field name="initial_value" optional="show"/>
                                    <field name="resale_state" optional="show"/>
                                </list>
                            </field>
                        </page>
                        <page string="Stock Receipts">
                            <field name="receipt_picking_ids" readonly="1">
                                <list>
                                    <field name="name"/>
                                    <field name="scheduled_date"/>
                                    <field name="date_done"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Vendor Bills">
                            <field name="bill_ids" readonly="state in ('locked','done')">
                                <list>
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="invoice_date"/>
                                    <field name="amount_untaxed"/>
                                    <field name="amount_tax"/>
                                    <field name="amount_total"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Cost Components">
                            <field name="component_ids" readonly="state in ('locked','done')">
                                <list editable="bottom">
                                    <field name="date"/>
                                    <field name="bill_id" optional="show"/>
                                    <field name="partner_id" optional="show"/>
                                    <field name="name"/>
                                    <field name="product_id" optional="show"/>
                                    <field name="component_type"/>
                                    <field name="amount_net"/>
                                    <field name="vat_amount"/>
                                    <field name="include_in_allocable"/>
                                    <field name="tax_treatment"/>
                                    <field name="source_document"/>
                                    <field name="currency_id" column_invisible="True"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="action_resale_acquisition_batch" model="ir.actions.act_window">
        <field name="name">Acquisition Batches</field>
        <field name="res_model">resale.acquisition.batch</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
