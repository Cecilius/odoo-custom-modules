<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_product_product_generic_catalog" model="ir.ui.view">
        <field name="name">product.product.form.generic.catalog</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Catalog &amp; Warranty" name="catalog_warranty">
                    <group>
                        <group string="Catalog">
                            <field name="brand_value_id" domain="[('resale_is_brand', '=', True)]"/>
                            <field name="condition_grade_value_id" domain="[('resale_is_condition_grade', '=', True)]"/>
                            <field name="asin"/>
                            <field name="upc" string="EAN / UPC"/>
                            <field name="manufacturer_serial"/>
                        </group>
                        <group string="Warranty">
                            <field name="warranty_policy_id" readonly="1"/>
                            <field name="warranty_start"/>
                            <field name="warranty_end"/>
                        </group>
                    </group>
                    <group string="Marketplace Links">
                        <field name="amazon_es_url" widget="url" readonly="1"/>
                        <field name="amazon_uk_url" widget="url" readonly="1"/>
                        <field name="camel_url" widget="url" readonly="1"/>
                    </group>
                </page>
                <page string="Resale Information" name="resale_information" invisible="not rfb and not batch_id">
                    <group>
                        <field name="rfb" readonly="1"/>
                        <field name="batch_id"/>
                        <field name="resale_state"/>
                        <field name="eval_done" readonly="1"/>
                        <field name="initial_value"/>
                        <field name="adjusted_value" readonly="1"/>
                        <field name="acquisition_cost" readonly="cost_status in ('locked','legacy_locked')"/>
                        <field name="cost_status" readonly="cost_status in ('locked','legacy_locked')"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
