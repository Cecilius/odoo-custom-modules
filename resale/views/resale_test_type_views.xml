<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_test_type_tree" model="ir.ui.view">
        <field name="name">resale.test.type.tree</field>
        <field name="model">resale.test.type</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="category_id"/>
                <field name="active" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_resale_test_type_form" model="ir.ui.view">
        <field name="name">resale.test.type.form</field>
        <field name="model">resale.test.type</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="category_id"/>
                        <field name="instructions"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_test_type" model="ir.actions.act_window">
        <field name="name">Test Types</field>
        <field name="res_model">resale.test.type</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
