<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_category_mapping_list" model="ir.ui.view">
        <field name="name">resale.category.mapping.list</field>
        <field name="model">resale.category.mapping</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="rfb_code"/>
                <field name="category_id"/>
                <field name="name" optional="show"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_resale_category_mapping_form" model="ir.ui.view">
        <field name="name">resale.category.mapping.form</field>
        <field name="model">resale.category.mapping</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="category_id"/>
                        <field name="rfb_code"/>
                        <field name="active"/>
                        <field name="sequence_id" readonly="1" optional="hide"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_category_mapping" model="ir.actions.act_window">
        <field name="name">Category Mappings</field>
        <field name="res_model">resale.category.mapping</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
