<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="resale_product_wizard_form" model="ir.ui.view">
        <field name="name">resale.product.wizard.form</field><field name="model">resale.product.wizard</field>
        <field name="arch" type="xml"><form string="AI Product Research"><sheet>
            <group string="Identify product"><field name="ean"/><field name="upc"/><field name="asin"/><field name="description"/><field name="additional_question" invisible="state != 'question'"/></group>
            <group string="AI result" invisible="state in ('draft', 'error')"><field name="ai_question" invisible="state != 'question'"/><field name="result_name"/><field name="result_category_id"/><field name="brand_attribute_id" invisible="1"/><field name="result_brand_value_id"/><field name="result_ean"/><field name="result_upc"/><field name="result_asin"/><field name="result_retail_price"/><field name="result_launch_year"/></group>
            <field name="ai_response" invisible="1"/><field name="state" invisible="1"/><field name="matched_product_id" invisible="1"/>
        </sheet><footer><button name="action_research" type="object" string="Research" class="btn-primary"/><button name="action_create_product" type="object" string="Create product" class="btn-primary" invisible="state not in ('matched', 'researched')"/><button string="Cancel" special="cancel" class="btn-secondary"/></footer></form></field>
    </record>
    <record id="action_resale_product_wizard" model="ir.actions.act_window"><field name="name">AI Product Research</field><field name="res_model">resale.product.wizard</field><field name="view_mode">form</field><field name="target">new</field></record>
    <menuitem id="menu_resale_product_wizard" name="AI Product Research" action="action_resale_product_wizard" sequence="90"/>
</odoo>
