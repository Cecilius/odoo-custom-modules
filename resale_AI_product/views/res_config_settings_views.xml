<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="res_config_settings_view_form" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.resale.ai.product</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="resale_base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='resale']/block[@name='resale_settings_block']" position="inside">
                <setting string="Product research agent">
                    <field name="resale_ai_research_agent_id"/>
                </setting>
                <setting string="Backup research agent">
                    <field name="resale_ai_backup_agent_id"/>
                </setting>
                <setting string="Default product category">
                    <field name="resale_ai_default_category_id"/>
                </setting>
                <setting string="Default brand">
                    <field name="resale_ai_default_brand_value_id"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
