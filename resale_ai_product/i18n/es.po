#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid "The AI agent returned an invalid structured response."
msgstr "El agente de IA devolvió una respuesta estructurada no válida."

#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid ""
"The AI proposal contains an identifier already present in the database. "
"Review the read-only comparison and edit the AI proposal before creating or "
"applying it."
msgstr ""
"La propuesta de IA contiene un identificador que ya existe en la base de "
"datos. Revise la comparación de solo lectura y edite la propuesta antes de "
"crearla o aplicarla."

#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid ""
"The edited identifiers are still used by existing products. Review the "
"comparison and remove or change the conflicting values."
msgstr ""
"Los identificadores editados siguen usándose en productos existentes. Revise"
" la comparación y elimine o cambie los valores en conflicto."

#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid "The existing product has no %s assigned."
msgstr "El producto existente no tiene %s asignado."

#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid ""
"The primary research agent was unavailable. The backup research agent "
"response is shown below."
msgstr ""
"El agente de investigación principal no estaba disponible. Se muestra a "
"continuación la respuesta del agente de respaldo."

#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid ""
"The supplied %(identifier)s does not match the existing product. Choose how "
"to handle it."
msgstr ""
"El %(identifier)s introducido no coincide con el producto existente. Elija "
"cómo gestionarlo."

#. module: resale_ai_product
#. odoo-python
#: code:addons/resale_ai_product/models/resale_product_wizard.py:0
msgid ""
"The supplied identifiers do not consistently identify one existing product. "
"Review the matches below."
msgstr ""
"Los identificadores introducidos no identifican de forma coherente un único "
"producto existente. Revise las coincidencias a continuación."

