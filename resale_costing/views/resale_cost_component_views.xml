<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resale_cost_component_tree" model="ir.ui.view">
        <field name="name">resale.cost.component.tree</field>
        <field name="model">resale.cost.component</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="batch_id"/>
                <field name="name"/>
                <field name="component_type"/>
                <field name="amount_net"/>
                <field name="vat_amount"/>
                <field name="include_in_allocable"/>
                <field name="tax_treatment"/>
            </list>
        </field>
    </record>

    <record id="view_resale_cost_component_form" model="ir.ui.view">
        <field name="name">resale.cost.component.form</field>
        <field name="model">resale.cost.component</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="batch_id"/>
                        <field name="date"/>
                        <field name="name"/>
                        <field name="component_type"/>
                        <field name="amount_net"/>
                        <field name="vat_amount"/>
                        <field name="currency_id" groups="base.group_multi_currency"/>
                        <field name="include_in_allocable"/>
                        <field name="tax_treatment"/>
                        <field name="source_document"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_resale_cost_component" model="ir.actions.act_window">
        <field name="name">Cost Components</field>
        <field name="res_model">resale.cost.component</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
